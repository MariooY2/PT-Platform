# PT Platform environment variables (docs/payments.md §8.4).
# Copy to .env.local and fill in. Never commit real values. Only NEXT_PUBLIC_* reach the browser.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=              # service role / secret key — server only, never NEXT_PUBLIC

# --- Payments ---
PAYMENTS_PROVIDER=mock                  # mock | whish
WHISH_ENV=sandbox                       # sandbox | production
WHISH_CHANNEL=
WHISH_SECRET=                           # server only
WHISH_WEBSITE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=                         # server only
EMAIL_FROM=

# --- Cron ---
CRON_SECRET=                            # server only

# --- Web push (Phase 3) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                      # server only
